# grammar rules: each of these is refused with E22 and a message that says why
refuse() { # refuse <desc> <message substring> <lord args...>
    local d="$1" want="$2"
    shift 2
    out=$(lord "$@" 2>&1); st=$?
    check "$d exits 22" test "$st" = 22
    case $out in *"$want"*) ok "$d says why";; *) bad "$d message: $out";; esac
}
refuse "list with a dir" "takes no directory" list "$R32"
refuse "all with a dir" "takes no directory" all "$R32"
refuse "prune with a dir" "takes no directory" prune "$R32"
refuse "list with -n" "takes no -n" list -n
refuse "id with -n" "takes no -n" id -n
refuse "command after its flag" "goes first" -n all
refuse "old -a" "-a is now: lord all" -a
refuse "old -e" "-e is now: lord eject" -e
refuse "old -i" "-i is now: lord id" -i
refuse "old -l" "-l is now: lord list" -l
refuse "unknown word" "unknown command or directory: frob" frob
refuse "two directories" "too many arguments" "$R32" "$R32"

