# --- registry, -l and -a -------------------------------------------------
# reg_has <state dir> <path>: the registry lists the path
reg_has() {
    awk -v p="$2" '{ sub(/^[^ ]+ /, "") } $0 == p { f = 1 } END { exit !f }' "$1/checkouts"
}

