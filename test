check "list time field is ISO" sh -c "lord list | awk -F '\t' -v p='$R30' '\$3 == p' | grep -Eq '^ok	[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z	'"
rm -f "$R30/.env"; printf 'R=1\n' > "$R30/.env"   # identical copy: relink pending
